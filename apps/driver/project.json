{
  "name": "driver",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/driver/src",
  "tags": ["scope:driver", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/driver",
        "browser": "apps/driver/src/main.ts",
        "tsConfig": "apps/driver/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/driver/public"
          }
        ],
        "styles": ["apps/driver/src/styles.css"]
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/driver/src/environments/environment.ts",
              "with": "apps/driver/src/environments/environment.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "10kb"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "apps/driver/ngsw-config.json"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "build-host": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/build-csr-host.mjs",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "outputs": ["{workspaceRoot}/dist/hosts/driver"],
      "defaultConfiguration": "production",
      "configurations": {
        "production": {
          "command": "node tools/build-csr-host.mjs driver production"
        },
        "development": {
          "command": "node tools/build-csr-host.mjs driver development"
        }
      }
    },
    "serve-bff": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "bun --watch apps/driver/src/server.ts",
        "env": { "PORT": "4301" }
      }
    },
    "serve": {
      "dependsOn": ["serve-bff"],
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "apps/driver/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "driver:build:production"
        },
        "development": {
          "buildTarget": "driver:build:development"
        }
      }
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "driver:build",
        "port": 4200,
        "staticFilePath": "dist/apps/driver/browser",
        "spa": true
      }
    }
  }
}
