{
  "name": "panel-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/panel-e2e/src",
  "implicitDependencies": ["panel"],
  "// targets": "to see all targets run: nx show project panel-e2e --web",
  "targets": {
    "e2e": {
      "dependsOn": [],
      "inputs": [
        "default",
        "^production",
        { "env": "BASE_URL" },
        { "env": "AUTH_BFF_E2E" },
        { "env": "AUTH_FIXTURE_ORIGIN" },
        { "env": "PLAYWRIGHT_CHROMIUM_CHANNEL" },
        { "env": "CI" },
        { "externalDependencies": ["@playwright/test"] }
      ]
    }
  }
}
